PORT=4000

# For Docker: postgresql://postgres:postgres@postgres:5432/home_library
# For local: postgresql://postgres:postgres@localhost:5432/home_library
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_library

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h
