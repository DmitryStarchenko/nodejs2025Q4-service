PORT=4000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library

# For Docker: use 'postgres' as host, for Local: use 'localhost' as host
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/home_library

CRYPT_SALT=10

JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123

TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Logging configuration
LOG_LEVEL=LOG
LOG_TO_FILE=false
LOG_DIR=logs
MAX_LOG_FILE_SIZE_KB=1024

# Error handling configuration
EXIT_ON_UNHANDLED_REJECTION=false
